{
  "openapi": "3.1.1",
  "info": {
    "title": "國土測繪多維度空間 3D 建物屬性 API",
    "version": "v1",
    "description": "提供三維建物屬性服務狀態、建物圖層、資料來源與建物屬性查詢。建物屬性查詢依 request body 的 Type 區分 Polygon、District 與 Circle 三種模式。API 主版本為 v1.0；本 OAS 文件修訂版為 v1.1。"
  },
  "servers": [
    {
      "url": "https://download03.nlsc.gov.tw/WebApi",
      "description": "正式環境"
    }
  ],
  "tags": [
    {
      "name": "建物屬性",
      "description": "依多邊形、行政區／地籍條件或圓形範圍查詢三維建物屬性。"
    }
  ],
  "paths": {
    "/BuildingAttributes/Status": {
      "post": {
        "operationId": "3dms_bldg3d_v1_BAStatus",
        "summary": "API_開放_三維建物模型屬性查詢_服務狀態查詢",
        "description": "查詢三維建物屬性查詢服務目前是否正常啟動。本 API 不需帶入任何參數。",
        "tags": [
          "建物屬性"
        ],
        "x-updateTime": "2026-07-21T00:00:00+08:00",
        "responses": {
          "200": {
            "description": "服務狀態查詢成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingAttributesStatusResponse"
                },
                "example": {
                  "Data": "三維建物屬性查詢服務啟動中 ...",
                  "Status": {
                    "Code": 200,
                    "Message": "success"
                  }
                }
              }
            }
          }
        }
      }
    },
