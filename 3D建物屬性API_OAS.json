    "/BuildingAttributes/QueryBuildingAttributes": {
      "post": {
        "operationId": "3dms_bldg3d_v1_BAQueryBuildingAttributes",
        "summary": "API_開放_三維建物模型屬性查詢",
        "description": "依 Type 選擇查詢方式：\n\n- `Polygon`：以多邊形範圍查詢。\n- `District`：以行政區、地號、地段及地址查詢。\n- `Circle`：以中心點及半徑查詢。\n\n`Coordinates` 的每一組座標順序皆為 `[經度, 緯度]`。",
        "tags": [
          "建物屬性"
        ],
        "x-updateTime": "2026-07-21T00:00:00+08:00",
        "requestBody": {
          "required": true,
          "description": "依 Type 帶入對應的 JSON 請求格式。",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/PolygonQueryRequest"
                  },
                  {
                    "$ref": "#/components/schemas/DistrictQueryRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CircleQueryRequest"
                  }
                ],
                "discriminator": {
                  "propertyName": "Type",
                  "mapping": {
                    "Polygon": "#/components/schemas/PolygonQueryRequest",
                    "District": "#/components/schemas/DistrictQueryRequest",
                    "Circle": "#/components/schemas/CircleQueryRequest"
                  }
                }
              },
              "examples": {
                "Polygon": {
                  "summary": "多邊形範圍查詢",
                  "value": {
                    "Type": "Polygon",
                    "Name": "110_臺中市",
                    "MinBuildingAge": 1,
                    "MaxBuildingAge": 30,
                    "MinBuildingFloor": 1,
                    "MaxBuildingFloor": 5,
                    "Coordinates": [
                      [
                        120.65696409696955,
                        24.159068438755753
                      ],
                      [
                        120.65511198571312,
                        24.14729020605607
                      ],
                      [
                        120.68759407481394,
                        24.147887929534605
                      ],
                      [
                        120.68695903359378,
                        24.159185053287075
                      ],
                      [
                        120.65696409696955,
                        24.159068438755753
                      ]
                    ]
                  }
                },
                "District": {
                  "summary": "行政區／地籍條件查詢",
                  "value": {
                    "Type": "District",
                    "Name": "110_臺中市",
                    "CityDistrict": "臺中市南屯區",
                    "LandNumber": "11780001",
                    "Section": "田心段",
                    "Address": "五權西路二段384號"
                  }
                },
                "Circle": {
                  "summary": "圓形範圍查詢",
                  "value": {
                    "Type": "Circle",
                    "Name": "110_臺中市",
                    "MinBuildingAge": 1,
                    "MaxBuildingAge": 30,
                    "MinBuildingFloor": 1,
                    "MaxBuildingFloor": 5,
                    "Radius": 1359.1690525031886,
                    "Coordinates": [
                      [
                        120.67006556415129,
                        24.151841252407266
                      ]
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "查詢成功。Data 為符合條件的建物屬性陣列；查無資料時可為空陣列。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingAttributeQueryResponse"
                },
                "examples": {
                  "Success": {
                    "summary": "成功回傳",
                    "value": {
                      "Data": [
                        {
                          "MODEL_LOD": "1",
                          "BUILD_ID": "21WPU6D49F",
                          "BUILD_NO": "5",
                          "BUILD_H": "20.840",
                          "H_SOURCE": "LiDAR產製DSM",
                          "H_EXTRAC": "DSM最大與最小值分10層取眾數層",
                          "SOURCE": "1/1000地形圖",
                          "MDATE": "201412",
                          "M_MDATE": "",
                          "COUNTY": "臺中市",
                          "M_SOURCE": "國土測繪中心產製",
                          "BUILD_COMPLETED_DATE": "0870915"
                        }
                      ],
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  },
                  "NoData": {
                    "summary": "查無符合條件的建物",
                    "value": {
                      "Data": [],
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "請求參數格式錯誤、缺少必要欄位或 Type 不支援。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "Data": null,
                  "Status": {
                    "Code": 400,
                    "Message": "參數錯誤"
                  }
                }
              }
            }
          },
          "500": {
            "description": "伺服器內部錯誤。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "example": {
                  "Data": null,
                  "Status": {
                    "Code": 500,
                    "Message": "Internal server error."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Coordinate": {
        "type": "array",
        "description": "單一座標，固定依序為 `[經度, 緯度]`。",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "format": "double"
        },
        "example": [
          120.67006556415129,
          24.151841252407266
        ]
      },
      "PolygonQueryRequest": {
        "type": "object",
        "title": "Polygon 多邊形查詢",
        "additionalProperties": false,
        "required": [
          "Type",
          "Name",
          "MinBuildingAge",
          "MaxBuildingAge",
          "MinBuildingFloor",
          "MaxBuildingFloor",
          "Coordinates"
        ],
        "properties": {
          "Type": {
            "type": "string",
            "enum": [
              "Polygon"
            ],
            "description": "查詢模式，固定為 Polygon。"
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "description": "建物圖層名稱，格式例如 `110_臺中市`。",
            "example": "110_臺中市"
          },
          "MinBuildingAge": {
            "type": "integer",
            "minimum": 0,
            "description": "建物屋齡下限，單位為年。",
            "example": 1
          },
          "MaxBuildingAge": {
            "type": "integer",
            "minimum": 0,
            "description": "建物屋齡上限，應大於或等於 MinBuildingAge。",
            "example": 30
          },
          "MinBuildingFloor": {
            "type": "integer",
            "minimum": 0,
            "description": "建物樓層數下限。",
            "example": 1
          },
          "MaxBuildingFloor": {
            "type": "integer",
            "minimum": 0,
            "description": "建物樓層數上限，應大於或等於 MinBuildingFloor。",
            "example": 5
          },
          "Coordinates": {
            "type": "array",
            "description": "多邊形頂點座標，至少三組；每組格式為 `[經度, 緯度]`。範例以第一組與最後一組相同的方式閉合多邊形。",
            "minItems": 3,
            "items": {
              "$ref": "#/components/schemas/Coordinate"
            }
          }
        },
        "example": {
          "Type": "Polygon",
          "Name": "110_臺中市",
          "MinBuildingAge": 1,
          "MaxBuildingAge": 30,
          "MinBuildingFloor": 1,
          "MaxBuildingFloor": 5,
          "Coordinates": [
            [
              120.65696409696955,
              24.159068438755753
            ],
            [
              120.65511198571312,
              24.14729020605607
            ],
            [
              120.68759407481394,
              24.147887929534605
            ],
            [
              120.68695903359378,
              24.159185053287075
            ],
            [
              120.65696409696955,
              24.159068438755753
            ]
          ]
        }
      },
      "DistrictQueryRequest": {
        "type": "object",
        "title": "District 行政區／地籍條件查詢",
        "additionalProperties": false,
        "required": [
          "Type",
          "Name",
          "CityDistrict",
          "LandNumber",
          "Section",
          "Address"
        ],
        "properties": {
          "Type": {
            "type": "string",
            "enum": [
              "District"
            ],
            "description": "查詢模式，固定為 District。"
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "description": "建物圖層名稱，格式例如 `110_臺中市`。",
            "example": "110_臺中市"
          },
          "CityDistrict": {
            "type": "string",
            "minLength": 1,
            "description": "縣市及鄉鎮市區名稱。",
            "example": "臺中市南屯區"
          },
          "LandNumber": {
            "type": "string",
            "minLength": 1,
            "description": "地號。以字串傳入，避免前置零遺失。",
            "example": "11780001"
          },
          "Section": {
            "type": "string",
            "minLength": 1,
            "description": "地段名稱。",
            "example": "田心段"
          },
          "Address": {
            "type": "string",
            "minLength": 1,
            "description": "地址。",
            "example": "五權西路二段384號"
          }
        },
        "example": {
          "Type": "District",
          "Name": "110_臺中市",
          "CityDistrict": "臺中市南屯區",
          "LandNumber": "11780001",
          "Section": "田心段",
          "Address": "五權西路二段384號"
        }
      },
      "CircleQueryRequest": {
        "type": "object",
        "title": "Circle 圓形查詢",
        "additionalProperties": false,
        "required": [
          "Type",
          "Name",
          "MinBuildingAge",
          "MaxBuildingAge",
          "MinBuildingFloor",
          "MaxBuildingFloor",
          "Radius",
          "Coordinates"
        ],
        "properties": {
          "Type": {
            "type": "string",
            "enum": [
              "Circle"
            ],
            "description": "查詢模式，固定為 Circle。"
          },
          "Name": {
            "type": "string",
            "minLength": 1,
            "description": "建物圖層名稱，格式例如 `110_臺中市`。",
            "example": "110_臺中市"
          },
          "MinBuildingAge": {
            "type": "integer",
            "minimum": 0,
            "description": "建物屋齡下限，單位為年。",
            "example": 1
          },
          "MaxBuildingAge": {
            "type": "integer",
            "minimum": 0,
            "description": "建物屋齡上限，應大於或等於 MinBuildingAge。",
            "example": 30
          },
          "MinBuildingFloor": {
            "type": "integer",
            "minimum": 0,
            "description": "建物樓層數下限。",
            "example": 1
          },
          "MaxBuildingFloor": {
            "type": "integer",
            "minimum": 0,
            "description": "建物樓層數上限，應大於或等於 MinBuildingFloor。",
            "example": 5
          },
          "Radius": {
            "type": "number",
            "format": "double",
            "exclusiveMinimum": 0,
            "description": "查詢半徑，單位為公尺。",
            "example": 1359.1690525031886
          },
          "Coordinates": {
            "type": "array",
            "description": "圓心座標，只能有一組；格式為 `[經度, 緯度]`。",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/Coordinate"
            }
          }
        },
        "example": {
          "Type": "Circle",
          "Name": "110_臺中市",
          "MinBuildingAge": 1,
          "MaxBuildingAge": 30,
          "MinBuildingFloor": 1,
          "MaxBuildingFloor": 5,
          "Radius": 1359.1690525031886,
          "Coordinates": [
            [
              120.67006556415129,
              24.151841252407266
            ]
          ]
        }
      },
      "BuildingAttribute": {
        "type": "object",
        "description": "單筆建物屬性。API 回傳的數值型內容目前以字串表示。",
        "required": [
          "MODEL_LOD",
          "BUILD_ID",
          "BUILD_NO",
          "BUILD_H",
          "H_SOURCE",
          "H_EXTRAC",
          "SOURCE",
          "MDATE",
          "M_MDATE",
          "COUNTY",
          "M_SOURCE",
          "BUILD_COMPLETED_DATE"
        ],
        "properties": {
          "MODEL_LOD": {
            "type": "string",
            "description": "建物模型細緻度（LOD）。",
            "example": "1"
          },
          "BUILD_ID": {
            "type": "string",
            "description": "建物識別碼。",
            "example": "21WPU6D49F"
          },
          "BUILD_NO": {
            "type": "string",
