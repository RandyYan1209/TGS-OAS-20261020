        ],
        "x-updateTime": "2026-07-21T00:00:00+08:00",
        "responses": {
          "200": {
            "description": "建物資料來源查詢成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildingDataSourceListResponse"
                },
                "examples": {
                  "Success": {
                    "summary": "成功取得資料來源清單",
                    "value": {
                      "Data": [
                        "1/1,000地形圖",
