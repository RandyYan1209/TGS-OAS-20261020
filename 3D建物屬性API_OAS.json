                      ],
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  },
                  "NoData": {
                    "summary": "目前沒有可使用的資料來源",
                    "value": {
                      "Data": [],
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
