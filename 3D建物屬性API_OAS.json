    "/BuildingAttributes/QueryBuildingDataSource": {
      "post": {
        "operationId": "3dms_bldg3d_v1_BAQueryBuildingDataSource",
        "summary": "API_開放_三維建物模型屬性查詢_建物框資料來源清單",
        "description": "取得目前可供建物屬性查詢使用的資料來源名稱清單。本 API 不需帶入任何參數。",
        "tags": [
