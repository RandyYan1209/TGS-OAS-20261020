    "/PartialBuildingService/Transfer_Request/SelectByPolygon/{serviceType}": {
      "post": {
        "operationId": "3dms_pubapi_v1_PBSTRSelectByPolygon",
        "tags": [
          "三維建物模型轉檔"
        ],
        "summary": "API_開放_指定多邊形三維建物模型轉檔",
        "description": "依多邊形範圍選取建物並建立三維建物模型轉檔工作， serviceType 可指定 i3s、3dtiles 或 both。使用本支API取得指定範圍之I3S與3D Tiles服務時，具有單次服務請求最大範圍及之模型棟數限制限制。圓形範圍半徑不得超過500公尺，矩形範圍長寬各不得超過500公尺；模型棟數則限制不能超過500棟。呼叫API後即時轉檔產生之I3S服務網址對應至國土測繪圖資三維建物模型I3S服務中「三維建物單棟或區域式服務發布」；呼叫API後即時轉檔產生之3D Tiles服務網址則對應至國土測繪圖資三維建物模型3D Tiles服務中「三維建物單棟或區域式服務發布」。受理成功後，請由 Data.ServiceUrls 取得介接網址；等待時間、保留天數與到期時間分別以 Data.Notice、Data.RetentionDays 與 Data.ExpirationTime 為準。介接網址使用期限為7天。",
        "x-updateTime": "2026-10-08T00:00:00+08:00",
        "parameters": [
          {
            "name": "serviceType",
            "in": "path",
            "required": true,
            "description": "指定產製的三維模型服務類型：i3s、3dtiles 或 both。",
            "schema": {
              "type": "string",
              "enum": [
                "i3s",
                "3dtiles",
                "both"
              ],
              "example": "both"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "指定範圍、座標系統及建物圖層。",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartialBuildingService_Transfer_Request_SelectByPolygon_body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API 呼叫完成；受理成功時 Data 為物件，包含 Message、Notice、ServiceUrls、RetentionDays、ExpirationTime、ExpirationNotice 與 PartialLayerName。錯誤回應可能是序列化的 JSON 字串，且 HTTP 200 不代表 Status.Code 必為 200。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartialBuildingService_Transfer_Response"
                },
                "examples": {
                  "i3sExample": {
                    "summary": "產製 I3S",
                    "value": {
                      "Data": {
                        "Message": "您的三維建物區域式服務 API 已開始進行轉檔發布作業。",
                        "Notice": "請於 5~10 分鐘完成後再行使用。",
                        "ServiceUrls": {
                          "I3S": "https://i3s.nlsc.gov.tw/WebAPI/PartialBuildingService/I3S_Service/i3s/rest/services/宜蘭縣_1151008_1151_ezpy/SceneServer/layers/0"
                        },
                        "RetentionDays": 7,
                        "ExpirationTime": "2026/10/15 上午 11:51:48",
                        "ExpirationNotice": "介接網址僅保留 7 天使用期，預計於 2026/10/15 上午 11:51:48 停止服務。",
                        "PartialLayerName": "宜蘭縣_1151008_1151_ezpy"
                      },
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  },
                  "threeDTilesExample": {
                    "summary": "產製 3D Tiles",
                    "value": {
                      "Data": {
                        "Message": "您的三維建物區域式服務 API 已開始進行轉檔發布作業。",
                        "Notice": "請於 5~10 分鐘完成後再行使用。",
                        "ServiceUrls": {
                          "3DTiles": "https://3dtiles.nlsc.gov.tw/WebAPI/PartialBuildingService/3DT_Service/宜蘭縣_1151008_1151_ezpy/tileset.json"
                        },
                        "RetentionDays": 7,
                        "ExpirationTime": "2026/10/15 上午 11:51:48",
                        "ExpirationNotice": "介接網址僅保留 7 天使用期，預計於 2026/10/15 上午 11:51:48 停止服務。",
                        "PartialLayerName": "宜蘭縣_1151008_1151_ezpy"
                      },
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  },
                  "bothExample": {
                    "summary": "同時產製 I3S 與 3D Tiles",
                    "value": {
                      "Data": {
                        "Message": "您的三維建物區域式服務 API 已開始進行轉檔發布作業。",
                        "Notice": "請於 5~10 分鐘完成後再行使用。",
                        "ServiceUrls": {
                          "I3S": "https://i3s.nlsc.gov.tw/WebAPI/PartialBuildingService/I3S_Service/i3s/rest/services/宜蘭縣_1151008_1151_ezpy/SceneServer/layers/0",
                          "3DTiles": "https://3dtiles.nlsc.gov.tw/WebAPI/PartialBuildingService/3DT_Service/宜蘭縣_1151008_1151_ezpy/tileset.json"
                        },
                        "RetentionDays": 7,
                        "ExpirationTime": "2026/10/15 上午 11:51:48",
                        "ExpirationNotice": "介接網址僅保留 7 天使用期，預計於 2026/10/15 上午 11:51:48 停止服務。",
                        "PartialLayerName": "宜蘭縣_1151008_1151_ezpy"
                      },
                      "Status": {
                        "Code": 200,
                        "Message": "success"
                      }
                    }
                  },
                  "failureExample": {
                    "summary": "條件未篩選到建物（JSON 字串）",
                    "value":{
                      "Data":"The number of buildings filtered by this condition is 0. Please reconfirm the condition.",
                      "Status":{
                         "Code":400,
                         "Message":"Bad Request"
                        }
                     }
                  }
                }
              }
            }
          },
          "500": {
            "description": "已觀察到多邊形查詢發生未處理的例外時，伺服器回傳 HTTP 500 與 HTML 錯誤頁面；此回應不是 Data／Status JSON。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "伺服器產生的 HTML 錯誤頁面。"
                }
              }
            }
          }
        }
      }
    },
